---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../data/site';
import { getPosts, postHref, withBase } from '../lib/posts';

const posts = await getPosts();
---
<Base title={`Page not found · ${SITE_NAME}`} description="This page does not exist.">
  <section class="wrap notfound">
    <h1>Page not found</h1>
    <p>This address does not lead to a page. The link may be old, or the address mistyped.</p>
    <p><a href={withBase('/')}>See all projects</a> or <a href={withBase('/contact/')}>get in touch</a>.</p>

    {posts.length > 0 && (
      <>
        <h2>Projects</h2>
        <ul class="taglist">
          {posts.map((p) => <li><a href={postHref(p)}>{p.data.title}</a></li>)}
        </ul>
      </>
    )}
  </section>
</Base>
