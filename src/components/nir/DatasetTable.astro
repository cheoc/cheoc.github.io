---
import { DATASETS } from '../../data/nir-benchmark';
---
<div class="table-box wide" role="region" aria-label="The ten datasets" tabindex="0">
  <table>
    <thead>
      <tr>
        <th scope="col">Dataset</th><th scope="col">Source</th><th scope="col" class="num">Samples</th>
        <th scope="col">Measured properties</th><th scope="col">Instrument</th><th scope="col">Wavelengths</th>
        <th scope="col">Published split</th><th scope="col">Licence</th>
      </tr>
    </thead>
    <tbody>
      {DATASETS.map((d) => (
        <tr>
          <td><b>{d.name}</b></td>
          <td>{d.source}</td>
          <td class="num">{d.samples}{d.samplesNote && <span class="sub">{d.samplesNote}</span>}</td>
          <td>{d.properties}</td>
          <td>{d.instrument}</td>
          <td class="nowrap">{d.range.replace(' nm', ' nm')}<span class="sub">{d.points}</span></td>
          <td>{d.split}</td>
          <td>{d.licence}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
